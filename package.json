{
  "name": "mirai",
  "description": "A personal command center for organizing bookmarks, tasks, notes, and everyday resources.",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mirai": "tsx --tsconfig scripts/mirai/tsconfig.json scripts/mirai/cli.ts",
    "test:unit:cli": "vitest run --project mirai-cli",
    "test:unit:cli:watch": "vitest --project mirai-cli",
    "db:up": "colima start && docker compose up -d",
    "db:down": "docker compose down && colima stop",
    "start": "pnpm db:up && pnpm dev",
    "stop": "pnpm db:down"
  },
  "imports": {
    "#mirai/*": "./scripts/mirai/*.ts"
  },
  "dependencies": {
    "@nuxt/eslint": "1.16.0",
    "@nuxt/ui": "4.8.2",
    "@scalar/nuxt": "0.6.46",
    "@tanstack/vue-query": "5.101.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "14.3.0",
    "@vueuse/router": "14.3.0",
    "consola": "3.4.2",
    "eslint": "10.4.1",
    "mongoose": "9.7.0",
    "nuxt": "^4.4.8",
    "nuxt-auth-utils": "0.5.29",
    "tailwindcss": "4.3.0",
    "vue": "^3.5.35",
    "vue-router": "5.1.0",
    "zod": "4.4.3"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.114",
    "@nuxt/kit": "^4.4.8",
    "@types/node": "25.9.3",
    "citty": "0.2.2",
    "pathe": "2.0.3",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "3.3.4"
  }
}
